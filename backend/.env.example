# Application
APP_ENV=development
LOG_LEVEL=INFO

# Database
# Local dev default (SQLite). In production on Render, set this to the
# free Postgres instance's connection string instead -- SQLite is a file
# on disk and most hosting platforms wipe local disk on every restart/
# redeploy, so processed-document history would silently vanish.
DATABASE_URL=sqlite:///./document_intelligence.db

# LLM / extraction provider (Groq free tier -- no credit card required)
# Get a key at console.groq.com/keys
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1

# OCR provider (leave blank to use local Tesseract)
OCR_PROVIDER=tesseract
OCR_API_KEY=
# Windows only, if tesseract isn't on PATH after installing it:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# File limits
MAX_PAGE_COUNT=3
ALLOWED_FILE_TYPES=application/pdf,image/jpeg,image/png

# CORS -- "*" is fine for local dev. In production, set this to the
# real deployed frontend origin(s), comma-separated if more than one,
# e.g. https://your-frontend.onrender.com
ALLOWED_ORIGINS=*